{
  "permissions": {
    "allow": [
      "Bash",
      "Write",
      "Read",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "Bash(git merge *)",
      "Read(//home/cfbieder/psproject-cr098/server/src/v2/repositories/**)",
      "Read(//home/cfbieder/psproject-cr098-build/server/src/services/**)",
      "Read(//home/cfbieder/psproject-cr098-build/server/db/migrations/**)",
      "Read(//home/cfbieder/psproject-cr098-build/docs/cr/**)",
      "Read(//home/cfbieder/psproject-cr098-build/frontend/src/pages/**)",
      "Bash(docker rm *)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(sudo rm:*)"
    ],
    "additionalDirectories": [
      "/home/cfbieder/psproject-cr064p2/server/src/v2/routes",
      "/home/cfbieder/psproject-cr064p2/server/src/v2/services/__tests__",
      "/home/cfbieder/psproject-cr064p2/frontend/src/features/Forecast",
      "/home/cfbieder/psproject-cr064p2/frontend/src/pages",
      "/home/cfbieder/psproject-cr098-build/server/src/v2/routes",
      "/home/cfbieder/psproject-cr098-build/server/src/services/__tests__",
      "/home/cfbieder/psproject-cr098-build/server/src/services",
      "/home/cfbieder/psproject-cr098-build/frontend/src/pages",
      "/home/cfbieder/psproject-cr098-build/server/db/migrations"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/allow-bash-except-rm.sh\""
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"auto-allow all fetches (unattended session)\"}}'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-ci-status.sh\"",
            "timeout": 15,
            "statusMessage": "Checking CI on main..."
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-feed-health.sh\"",
            "timeout": 10,
            "statusMessage": "Checking bank feed consents..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/cfbieder/psproject/.claude/hooks/handoff-inbox.sh"
          }
        ]
      }
    ]
  }
}
